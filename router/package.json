{
  "name": "@dev-team/router",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Custom router for the dev-team Claude agent fleet. Ingests GitHub/Linear/Slack webhooks, classifies to one of 7 agents, spawns Claude Agent SDK sessions, streams replies back.",
  "engines": {
    "node": ">=20.10.0"
  },
  "bin": {
    "dev-team-logs": "dist/cli/main.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "format": "biome format --write src tests",
    "validate:fleet": "tsx scripts/validate-fleet-config.ts",
    "labels:github": "tsx scripts/github-labels.ts",
    "labels:protocols": "tsx scripts/linear-labels.ts",
    "labels:linear": "tsx scripts/linear-labels-sync.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.204",
    "@fastify/sensible": "^6.0.0",
    "@infisical/sdk": "^5.0.2",
    "@octokit/auth-app": "^8.2.0",
    "better-sqlite3": "^11.10.0",
    "croner": "^10.0.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "js-yaml": "^4.3.0",
    "minimatch": "^10.2.5",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^20.17.0",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "better-sqlite3",
      "esbuild"
    ]
  }
}
