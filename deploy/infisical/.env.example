# Infisical self-hosted config — copy to `.env` next to this file.
# Full docs: https://infisical.com/docs/self-hosting/deployment-options/docker-compose

# ---- Encryption key (32 bytes hex) — generate ONCE + never rotate ----------
# openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_32_BYTES_HEX

# ---- Auth key + JWT signing (each 32 bytes hex) ----------------------------
AUTH_SECRET=CHANGE_ME_32_BYTES_HEX
JWT_AUTH_SECRET=CHANGE_ME_32_BYTES_HEX
JWT_SIGNUP_SECRET=CHANGE_ME_32_BYTES_HEX
JWT_REFRESH_SECRET=CHANGE_ME_32_BYTES_HEX
JWT_SERVICE_SECRET=CHANGE_ME_32_BYTES_HEX
JWT_MFA_SECRET=CHANGE_ME_32_BYTES_HEX
JWT_PROVIDER_AUTH_SECRET=CHANGE_ME_32_BYTES_HEX

# ---- Postgres backing store ------------------------------------------------
# Infisical bundles a Postgres container in its own compose; these tell the
# API service how to reach it.
POSTGRES_USER=infisical
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=infisical
DB_CONNECTION_URI=postgresql://infisical:CHANGE_ME@infisical-db:5432/infisical

# ---- Redis (session cache) -------------------------------------------------
REDIS_URL=redis://infisical-redis:6379

# ---- Router bootstrap credentials (created inside Infisical UI) ------------
# After first-boot, create a project + service token in the UI and put its
# token here — it's what the router reads via INFISICAL_TOKEN in ../.env.
# See ../../README.md → "Infisical bootstrap".
