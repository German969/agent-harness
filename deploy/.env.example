# dev-team router — deploy environment.
# Copy to `.env` in this directory and fill in real values before `docker compose up`.
# NEVER commit `.env` — it contains bootstrap secrets.

# ---- Router runtime ---------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
PORT=8080
HOST=0.0.0.0
STATE_DB_PATH=/var/lib/agents/state.sqlite
DEV_TEAM_ROOT=/var/lib/agents/dev-team
SESSION_LOG_DIR=/var/log/agents/sessions

# ---- Secrets provider (Infisical) ------------------------------------------
# The router fetches all per-session credentials from Infisical at session prep
# time. Only these four vars need to be in .env; every other secret lives in
# Infisical and gets pulled dynamically.
SECRETS_PROVIDER=infisical
INFISICAL_SITE_URL=https://app.infisical.com
INFISICAL_PROJECT_ID=CHANGE_ME
INFISICAL_ENVIRONMENT=dev
# Machine-identity (Universal Auth) credentials — created in Infisical UI:
# Access Control → Identities → your identity → Authentication → Universal Auth.
INFISICAL_CLIENT_ID=CHANGE_ME
INFISICAL_CLIENT_SECRET=CHANGE_ME

# ---- Anthropic API key -----------------------------------------------------
# In prod: leave blank. The router fetches ANTHROPIC_API_KEY per session from
# Infisical via each identity's secrets block, then hands it to the Anthropic
# SDK adapter at session runtime.
#
# In local dev (SECRETS_PROVIDER=env): set the key here so the adapter picks it
# up at startup.
ANTHROPIC_API_KEY=

# ---- dev-team repo (config source for hot-reload) --------------------------
DEV_TEAM_REPO_URL=git@github.com:German969/dev-team.git
DEV_TEAM_REPO_BRANCH=main

# ---- Cloudflare Tunnel -----------------------------------------------------
# The tunnel is provisioned in the Cloudflare dashboard; drop the credentials
# JSON into ./cloudflared/credentials.json + update config.yml with the tunnel id.
# See ./cloudflared/config.example.yml.
